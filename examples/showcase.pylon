---
color: true
data:
  sales:
    - x: Mon
      y: 10
    - x: Tue
      y: 20
    - x: Wed
      y: 15
    - x: Thu
      y: 25
  trend:
    - x: 1
      y: 5
    - x: 2
      y: 12
    - x: 3
      y: 18
    - x: 4
      y: 25
    - x: 5
      y: 22
    - x: 6
      y: 35
    - x: 7
      y: 40
    - x: 8
      y: 38
  activity:
    - x: Mon
      y: [1, 3, 5, 7, 2]
    - x: Tue
      y: [0, 2, 4, 3, 1]
    - x: Wed
      y: [2, 5, 6, 4, 2]
    - x: Thu
      y: [0, 1, 3, 2, 0]
  week:
    - x: Mon
      o: 10
      h: 14
      l: 8
      c: 12
    - x: Tue
      o: 12
      h: 13
      l: 9
      c: 10
    - x: Wed
      o: 10
      h: 16
      l: 10
      c: 15
    - x: Thu
      o: 15
      h: 15
      l: 11
      c: 11
    - x: Fri
      o: 11
      h: 13
      l: 11
      c: 13
  sprint:
    - x: spec
      start: 0
      end: 5
    - x: code
      start: 3
      end: 12
    - x: test
      start: 10
      end: 16
    - x: ship
      start: 14
      end: 20
  signups:
    - x: w1
      y: 5
    - x: w2
      y: 12
    - x: w3
      y: 14
    - x: w4
      y: 25
    - x: w5
      y: 40
    - x: w6
      y: 55
  letters:
    - x: A
      y: 3
    - x: B
      y: 7
    - x: C
      y: 5
    - x: D
      y: 2
    - x: E
      y: 4
  goals:
    - x: Sales
      y: 70
      target: 100
    - x: Stock
      y: 25
      target: 80
  scores:
    - x: A
      min: 5
      q1: 12
      med: 18
      q3: 24
      max: 30
    - x: B
      min: 8
      q1: 14
      med: 20
      q3: 28
      max: 35
  hits:
    - date: "2026-01-05"
      y: 3
    - date: "2026-01-12"
      y: 5
    - date: "2026-01-15"
      y: 1
    - date: "2026-01-20"
      y: 4
---
[ Pylon | banner ]
[ @sales | bar ]
[ @sales | vbar ]
[ @trend | sparkline ]
[ @trend | line ]
[ @trend | area ]
[ @trend | scatter ]
[ @activity | heatmap ]
[ @activity | sbar ]
[ @week | candlestick ]
[ @letters | hist ]
[ @signups | step ]
[ @sprint | gantt ]
[ @goals | bullet ]
[ @scores | box ]
[ @hits | calendar ]
[ 75 | progress ]
[ foo | mystery ]
[- @sales | text -]
[ Start ] -> [ Process ] -> [ End ]
[- a :: x -] -> [ b ] -> &x
